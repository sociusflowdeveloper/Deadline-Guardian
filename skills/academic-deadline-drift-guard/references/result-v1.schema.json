{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deadline Guardian draft result v1",
  "description": "Structural contract only; output records must preserve source input values and references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_status",
    "before_snapshot_id",
    "after_snapshot_id",
    "changes",
    "confirmed_changes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "result_status": {
      "const": "REVIEW_REQUIRED"
    },
    "before_snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "after_snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "changes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "confirmed_changes": {
      "type": "array",
      "maxItems": 0
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "module_id",
        "title",
        "due_date",
        "due_time",
        "timezone",
        "time_precision",
        "source_id",
        "source_excerpt",
        "explicit_cancellation",
        "user_confirmed"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "module_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
        },
        "due_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])(?![\\s\\S])"
        },
        "due_time": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?![\\s\\S])"
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:\\+00:00|[+-](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))(?![\\s\\S])",
          "not": {
            "const": "-00:00"
          }
        },
        "time_precision": {
          "enum": [
            "date",
            "minute",
            "unknown",
            "none"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "source_excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*(?![\\s\\S])"
        },
        "explicit_cancellation": {
          "type": "boolean"
        },
        "user_confirmed": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "explicit_cancellation": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "time_precision": {
                "const": "none"
              },
              "due_date": {
                "type": "null"
              },
              "due_time": {
                "type": "null"
              },
              "timezone": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "explicit_cancellation": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "time_precision": {
                "enum": [
                  "date",
                  "minute",
                  "unknown"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "time_precision": {
                "const": "date"
              }
            }
          },
          "then": {
            "properties": {
              "due_date": {
                "type": "string"
              },
              "due_time": {
                "type": "null"
              },
              "timezone": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "time_precision": {
                "const": "minute"
              }
            }
          },
          "then": {
            "properties": {
              "due_date": {
                "type": "string"
              },
              "due_time": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "time_precision": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "due_date": {
                "type": "null"
              },
              "due_time": {
                "type": "null"
              },
              "timezone": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "source_id",
        "source_excerpt"
      ],
      "properties": {
        "side": {
          "enum": [
            "before",
            "after"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "source_excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*(?![\\s\\S])"
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "item_id",
        "status",
        "reason_code",
        "before",
        "candidates",
        "source_references",
        "requires_user_review",
        "user_confirmed"
      ],
      "properties": {
        "module_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "status": {
          "enum": [
            "UNCHANGED",
            "ADDED",
            "CHANGED",
            "REMOVED",
            "CONFLICT",
            "UNVERIFIED"
          ]
        },
        "reason_code": {
          "enum": [
            "SAME_VALUE",
            "NEW_ITEM",
            "VALUE_CHANGED",
            "EXPLICIT_CANCELLATION",
            "MULTIPLE_VALUES",
            "PRIOR_CONFLICT",
            "PRIOR_UNCERTAINTY",
            "MISSING_CANDIDATE",
            "AMBIGUOUS_CANDIDATE",
            "INCOMPARABLE_PRECISION",
            "CANCELLATION_WITHOUT_BASELINE",
            "ALREADY_CANCELLED",
            "REAPPEARED_AFTER_CANCELLATION"
          ]
        },
        "before": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "candidates": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "source_references": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/source_reference"
          }
        },
        "requires_user_review": {
          "const": true
        },
        "user_confirmed": {
          "const": false
        }
      }
    }
  }
}
